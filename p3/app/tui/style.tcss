Screen {
  align: center middle;
}

#body {
  height: 1fr;
}

#left-panel {
  width: 100%;
  height: 1fr;
  border: round $primary;
  border-title-color: $text;
  padding: 1 2;
  background: transparent;
}

#right-panel {
  width: 2fr;
  height: 1fr;
  border: round $accent;
  padding: 1 2;
  border-title-color: $text;
  background: transparent;
}

#log-box {
  height: 1fr;
  border: round $success;
  padding: 0 1;
  background: transparent;
}


#history-list {
  height: 1fr;
  background: transparent;
}

#history-details {
  height: 100%;
  # border: round $accent;
  padding: 1 2;
  content-align: left top;
  background: transparent;
  overflow-y: auto;
}

DescButton {
  width: 1fr;
  margin-bottom: 1;
  border: round $primary;
  background: transparent;
}

ConfirmScriptScreen {
  align: center middle;
}

#confirm-dialog {
  width: 60%;
  max-width: 70;
  height: auto;
  border: thick $primary;
  background: $surface;
  padding: 1 2;
}

#confirm-title {
  text-style: bold;
  content-align: center middle;
  margin-bottom: 1;
  height: auto;
}

#confirm-description {
  border: round $accent;
  padding: 1 2;
  margin-bottom: 1;
  height: auto;
  max-height: 12;
}

#confirm-buttons {
  align: center middle;
  height: auto;
}

#confirm-buttons Button {
  margin: 0 2;
  min-width: 12;
}

#sudo-error {
  color: $error;
  text-style: bold;
  content-align: center middle;
  height: auto;
  margin-bottom: 1;
}

#sudo-password-input {
  margin-bottom: 1;
}

#logo {
  width: 100%;
  height: auto;
  content-align: center middle;
  background: transparent;
}

.home {    
  width: 58;
  max-width: 100%;
  height: auto;
  align: center middle;
}

.home Button {
  width: 30;
  margin: 1 1;
}

#home-menu {
  background: transparent;
  width: 100%;
  height: auto;
  margin-top: 2;
}

#home-menu Label {
  width: 100%;
  content-align: center middle;
}

.hello {
  width: 100%;
  height: auto;
  content-align: center middle;
}

.contributors-grid {
  layout: grid;
  grid-size: 3 2;
  grid-columns: 16;
  grid-gutter: 1 0;
  padding: 1 0;
  width: auto;
  height: auto;
}

.contributors-grid Static {
  content-align: center middle;
  width: 100%;
}

.home-links Link {
  margin: 0 2;
  color: $accent;
}

.home-links {
  dock: bottom;
  width: 100%;
  max-width: 100%;
  height: auto;
  align: center middle;
  padding: 1 0;
}

#left-column {
  width: 1fr;
  height: 1fr;
}

#search-input {
  margin-bottom: 1;
}

#search-registry {
  margin-bottom: 1;
}

#menu-panel {
  width: 2fr;
  height: 1fr;
  border: round $accent;
  padding: 1 2;
  align: center middle;
}

#menu-panel #logo {
  width: 100%;
  height: auto;
  content-align: center middle;
}

#terminal-conteiner {
  width: 2fr;
  height: 1fr;
}

Terminal {
  width: 100%;
  height: 100%;
}

.report-bug {
    color: $accent;
}

.report-bug:hover {
    color: $accent-lighten-2;
}

.report-bug:focus {
  text-style: reverse;
}

ReportBugDialog {
    align: center middle;
}

/* Container principal da Modal */
#dialog-container {
    width: 76;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

/* Linha superior (Aplicativo + Seleção) */
.form-row {
    height: auto;
    align-vertical: middle;
    margin-bottom: 1;
}

.label-inline {
    width: 1fr;
    content-align: left middle;
    height: 3;
}

/* Rótulos de campo */
.field-label {
    margin-bottom: 1;
}

/* Área de texto */
TextArea#bug-description {
    height: 8;
    margin-bottom: 1;
    background: $boost;
    border: none;
}

/* Informações do sistema */
#system-info-text {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

/* Container dos botões alinhado à direita */
#confirm-buttons {
    height: 3;
    align-horizontal: right;
}

#confirm-buttons Button {
    margin-left: 1;
    min-width: 12;
}

#cancel-btn {
    background: transparent;
    border: round $error;
}

#execute-btn {
    border: round $primary;
}

#select-app {
    width: 32;
    height: 3;
}

.field-label {
  margin-top: 1;
  margin-bottom: 1;
}
